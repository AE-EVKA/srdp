# Docker Compose project name (must be "local" so the network is named "local_app")
COMPOSE_PROJECT_NAME=local

# Masterkey for Zitadel to encrypt its data.
# Generate a 32-character value: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
ZITADEL_MASTERKEY=

# First-instance admin password. Zitadel requires uppercase, lowercase, digits,
# and at least one symbol (e.g. generate with a password manager, or by hand
# following that rule).
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=

# OIDC client credentials for our forward-auth helper
OIDC_CLIENT_ID=myOidcClientIdChangeMe # Change based on the client ID shown in Zitadel
OIDC_CLIENT_SECRET=myOidcClientSecretChangeMe # Change based on the client ID shown in Zitadel

# Cookie secret for oauth2-proxy's session cookie.
# Generate a 32-character value: tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
OIDC_COOKIE_SECRET=

# Shared Postgres. POSTGRES_PASSWORD is the superuser (also used by DuckLake's
# catalog metadata connection); the other three are per-service roles that the
# srdp-setup service creates (and re-syncs on every start, so changing one here
# and rerunning `docker compose up` rotates it). The database list itself lives
# in the [setup] table of srdp.toml at the repo root. Generate each with:
# tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24
POSTGRES_PASSWORD=
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=
DAGSTER_PG_PASSWORD=
MARQUEZ_DB_PASSWORD=
